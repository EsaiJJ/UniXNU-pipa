# Copy to ../UniXNU/unixnu.local.toml (or pass --config FILE) when building locally.
# unixnu.local.toml and local.toml are ignored by git.
[build]
device = "../UniXNU-pipa"
uefi = "../uefi-pipa"
fd = "../uefi-pipa/Build/pipaPkg/DEBUG_CLANGPDB/FV/SILICIUM_UEFI.fd"
dtb = "out/pipa/ipados-17.7.11-21H461/pipa/tree/build/pipa/pipa.dtb"
kernelcache = "out/ipsw/21H461/kernelcache.decompressed"
owner_trust_cache = "out/pipa/ipados-17.7.11-21H461/pipa/tree/build/adreno-metal-plugin/owner-trust.bundle"
gpu_addon = "out/pipa/ipados-17.7.11-21H461/pipa/tree/build/adreno-metal-plugin/gpu-addon-clients.bin"
# data_ramdisk = "/path/to/pipa-data-seed-8g.dbr"
# unique_chip_id = "0x1"
jobs = 8
target = "DEBUG"
